#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define ROWS 4
#define COLS 4

int main(void) {
    int matrix[ROWS][COLS];
    
    // Ініціалізація генератора випадкових чисел
    srand((unsigned int)time(NULL));

    // Заповнення матриці випадковими числами з діапазону [-50; 50]
    // Використовуємо лінійний прохід (Row-Major Order)
    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            matrix[i][j] = (rand() % 101) - 50;
        }
    }

    // Виведення вихідної матриці у вигляді акуратної таблиці
    printf("Вихідна матриця (%dx%d):\n", ROWS, COLS);
    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            printf("%6d ", matrix[i][j]);
        }
        printf("\n");
    }
    printf("\n");

    // 1. Для кожної колонки матриці знайти мінімальний елемент
    for (int j = 0; j < COLS; j++) {
        int min_col_val = matrix[0][j];
        for (int i = 1; i < ROWS; i++) {
            if (matrix[i][j] < min_col_val) {
                min_col_val = matrix[i][j];
            }
        }
        printf("Мінімальний елемент у колонці %d: %d\n", j, min_col_val);
    }
    printf("\n");

    // 2. Поміняти місцями перший і останній рядки
    for (int j = 0; j < COLS; j++) {
        int temp = matrix[0][j];
        matrix[0][j] = matrix[ROWS - 1][j];
        matrix[ROWS - 1][j] = temp;
    }

    // Виведення матриці після перестановки рядків
    printf("Матриця після перестановки першого та останнього рядків:\n");
    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            printf("%6d ", matrix[i][j]);
        }
        printf("\n");
    }

    return 0;
}